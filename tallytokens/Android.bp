package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Tally design tokens as Android resources: colours bound to the dynamic-colour roles, shapes,
// sizes, type, springs, timings and lamp forms. Resources only, no code. SystemUI, Launcher3 and
// the DiamaneOS overlays add it to their static_libs, as they do with dynamiccolors.
android_library {
    name: "tallytokens",
    sdk_version: "current",
    min_sdk_version: "31",
    resource_dirs: ["res"],
}
