package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Tally design tokens as Android resources: colours bound to the dynamic-colour roles, shapes,
// sizes, type, springs, timings and lamp forms. Resources only, no code. SystemUI, Launcher3,
// WindowManager-Shell and Settings add it to their static_libs next to dynamiccolors. Resource
// overlays and SettingsLib do not link it: they get literal values from the spec's exports.
android_library {
    name: "tallytokens",
    sdk_version: "current",
    min_sdk_version: "30",
    resource_dirs: ["res"],
}
